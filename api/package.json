{
  "name": "meridian-api",
  "version": "1.0.0",
  "private": true,
  "description": "Meridian: API REST de controle de frota (Trabalho de Curso, IESGO).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -b",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc -b",
    "banco:criar": "tsx --env-file=.env src/scripts/criar-banco.ts",
    "banco:popular": "tsx --env-file=.env src/scripts/popular-banco.ts",
    "banco:recriar": "npm run banco:criar && npm run banco:popular",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
