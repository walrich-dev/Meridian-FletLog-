# Copie este arquivo para .env.
#
# Endereço da API do Meridian. Com a API rodando na sua máquina
# (cd api && npm run dev), o valor abaixo já serve.
VITE_API_URL=http://localhost:3333/api

# ATENCAO, ao hospedar: este valor e lido durante o `npm run build` e fica
# gravado dentro do JavaScript gerado. Nao e lido quando o site roda. Ou seja,
# o endereco da API hospedada precisa estar configurado ANTES de buildar, no
# painel da hospedagem do front-end. Trocar o endereco depois exige um
# novo build. Veja docs/IMPLANTACAO.md.
